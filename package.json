{
  "name": "web3-plugin-tolar-workspace",
  "author": "tolar",
  "description": "Tolar HashNet plugin for web3.js with examples",
  "private": true,
  "workspaces": [
    "./packages/plugin",
    "./packages/examples/*"
  ],
  "homepage": "https://github.com/Tolar-HashNET/web3-plugin-tolar#readme",
  "bugs": {
    "url": "https://github.com/Tolar-HashNET/web3-plugin-tolar/issues"
  },
  "scripts": {
    "lint": "yarn workspaces foreach --from ./packages/plugin -Rv run lint",
    "build": "yarn workspaces foreach --from ./packages/plugin -Rv run build",
    "clean": "yarn workspaces foreach --from ./packages/plugin -Rv run clean",
    "test": "yarn workspaces foreach --from ./packages/plugin -Rv run test",
    "publish_localy": "yarn workspaces foreach --from ./packages/plugin -Rv run publish_localy",
    "lint:all": "yarn workspaces foreach --all -tvp run lint",
    "build:all": "yarn workspaces foreach --all -tvp run build",
    "clean:all": "yarn workspaces foreach --all -tvp run clean",
    "test:all": "yarn workspaces foreach --all -tvp run test"
  },
  "contributors": [
    {
      "name": "Tolar",
      "email": "info@tolar.io"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Tolar-HashNET/web3-plugin-tolar.git"
  },
  "devDependencies": {
    "@chainsafe/eslint-config": "^2.0.0",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.2.6",
    "eslint": "8",
    "eslint-plugin-jest": "^28.11.0",
    "ethereum-cryptography": "^2.2.1",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.5.0",
    "jest-extended": "^4.0.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "packageManager": "yarn@4.5.1+sha512.341db9396b6e289fecc30cd7ab3af65060e05ebff4b3b47547b278b9e67b08f485ecd8c79006b405446262142c7a38154445ef7f17c1d5d1de7d90bf9ce7054d"
}
