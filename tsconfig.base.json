{
	"compilerOptions": {
		"baseUrl": ".",
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"target": "es2020",
		"module": "commonjs",
		"declaration": true,
		"moduleResolution": "node",
		"noFallthroughCasesInSwitch": true,
		"noImplicitReturns": true,
		"noUnusedLocals": true,
		"noUnusedParameters": false,
		"pretty": true,
		"removeComments": true,
		"sourceMap": true,
		"declarationMap": true,
		"strict": true,
		"strictNullChecks": true,
		"esModuleInterop": true,
	},
	"exclude": [
		"node_modules",
		"lib",
		"dist"
	]
}
